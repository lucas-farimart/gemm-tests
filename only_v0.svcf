#
# PPE data
#
array set dbNames ""
set dbNames(realName1) [database require waves  -hints {
	file ./waves.shm/waves.trn
	file /home/lucas.martins/workspace/mestrado/gemm_tests/waves.shm/waves.trn
}]

#
# Conditions
#
set expression {tb_only_srams.DUT.word_W[31:0]}
if {[catch {condition new -name  condition -expr $expression}] != ""} {
    condition set -using condition -expr $expression
}
#
# Groups
#
catch {group new -name INPUTS -overlay 0}
catch {group new -name INPUT_MEM_CTRL -overlay 0}
catch {group new -name WEIGHT_MEM_CTRL -overlay 0}
catch {group new -name WEIGHTS -overlay 0}
catch {group new -name {DUT IF} -overlay 0}
group using INPUTS
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {$dbNames(realName1)::[format {tb_only_srams.DUT.X[31:0]}]} ] \
